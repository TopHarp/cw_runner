/** 全局样式 **/
page {
  background-color: #16213e;
  color: #e94560;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
}

/* 通用按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: opacity 0.15s;
}

.btn:active {
  opacity: 0.7;
}

.btn-primary {
  background-color: #e94560;
  color: #fff;
}

.btn-secondary {
  background-color: #0f3460;
  color: #e94560;
  border: 2rpx solid #e94560;
}

/* 滚动区域 */
.scroll-area {
  flex: 1;
  overflow-y: auto;
}

/* 列表项 */
.list-item {
  background-color: #0f3460;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 文字颜色 */
.text-primary { color: #e94560; }
.text-secondary { color: #a0a0a0; }
.text-code { color: #00d9ff; font-family: 'Courier New', monospace; }
