/* 首页样式 */

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #16213e;
}

/* ==================== 上半区：时序显示 ==================== */

.display-area {
  flex: 0 0 30%;
  display: flex;
  flex-direction: column;
  padding: 12rpx 24rpx 20rpx;
  border-bottom: 2rpx solid #0f3460;
}

.help-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}

.btn-help {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  background-color: transparent;
  color: #a0a0a0;
  border: 1rpx solid #555;
  border-radius: 8rpx;
  line-height: 1.4;
}

.btn-help::after {
  border: none;
}

.display-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.display-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e94560;
}

.display-actions {
  display: flex;
  gap: 16rpx;
}

.btn-clear {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  background-color: #0f3460;
  color: #a0a0a0;
  border: 2rpx solid #333;
  border-radius: 8rpx;
  line-height: 1.5;
}

.btn-delete {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  background-color: #0f3460;
  color: #e94560;
  border: 2rpx solid #e94560;
  border-radius: 8rpx;
  line-height: 1.5;
}
.btn-delete::after {
  border: none;
}
.btn-delete:active {
  opacity: 0.7;
}


.btn-clear::after {
  border: none;
}

.btn-send {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  background-color: #333;
  color: #666;
  border-radius: 8rpx;
  line-height: 1.5;
  transition: all 0.2s;
}

.btn-send::after {
  border: none;
}

.btn-send.active {
  background-color: #e94560;
  color: #fff;
}

.timing-scroll {
  flex: 1;
  background-color: #0f3460;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.timing-text {
  font-family: 'Courier New', monospace;
  font-size: 36rpx;
  color: #00d9ff;
  line-height: 1.6;
  word-break: break-all;
}

.timing-text.placeholder {
  color: #555;
  font-size: 28rpx;
}

.wpm-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wpm-label {
  font-size: 24rpx;
  color: #a0a0a0;
  flex-shrink: 0;
}

.wpm-slider {
  flex: 1;
}

.wpm-value {
  font-size: 24rpx;
  color: #e94560;
  font-weight: 600;
  flex-shrink: 0;
  min-width: 100rpx;
  text-align: right;
}

.gap-control {
  display: flex;
  align-items: center;      /* ← 修改：横向排列，与 wpm-control 一致 */
  gap: 16rpx;               /* ← 新增：与 wpm-control 一致 */
  margin-top: 12rpx;        /* ← 新增：与上方 wpm-control 间距 */
}

.gap-label {
  font-size: 24rpx;
  color: #a0a0a0;           /* ← 修改：与 wpm-label 颜色一致 */
  flex-shrink: 0;           /* ← 新增：与 wpm-label 一致 */
}

.gap-slider {
  flex: 1;                  /* ← 修改：占据剩余空间，与 wpm-slider 一致 */
}

.gap-value {                 /* ← 新增：显示数值，与 wpm-value 对应 */
  font-size: 24rpx;
  color: #e94560;           /* ← 与 wpm-value 颜色一致 */
  font-weight: 600;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}

/* ==================== 本地模式提示 ==================== */

.local-mode-banner {
  background-color: #e94560;
  padding: 12rpx 24rpx;
  text-align: center;
}

.local-mode-banner text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* ==================== 中间：模拟报文列表 ==================== */

.list-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx;
  overflow: hidden;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e94560;
}

.btn-refresh {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  background-color: #0f3460;
  color: #e94560;
  border: 2rpx solid #e94560;
  border-radius: 8rpx;
  line-height: 1.5;
}

.btn-refresh::after {
  border: none;
}

.btn-refresh:active {
  opacity: 0.7;
}

.list-scroll {
  flex: 1;
  height: 0;
}

.cw-item {
  display: flex;
  align-items: center;
  background-color: #0f3460;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.cw-index {
  font-size: 24rpx;
  color: #e94560;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
}

.cw-time {
  font-size: 24rpx;
  color: #a0a0a0;
  min-width: 120rpx;
  flex-shrink: 0;
}

.cw-code {
  font-family: 'Courier New', monospace;
  font-size: 28rpx;
  color: #00d9ff;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx; /* 限制宽度，确保只显示约8个字符 */
}

.btn-play {
  flex-shrink: 0;
  font-size: 32rpx;
  padding: 8rpx 20rpx;
  background-color: #e94560;
  color: #fff;
  border-radius: 8rpx;
  line-height: 1.2;
  min-width: 80rpx;
}

.btn-play::after {
  border: none;
}

.btn-play:active {
  opacity: 0.7;
}

.btn-play.playing {
  background-color: #0f3460;
  color: #e94560;
  border: 2rpx solid #e94560;
}

.list-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #555;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0 40rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #666;
}

.load-more-text.loading {
  color: #e94560;
}

.load-more-text.no-more {
  color: #444;
}

/* ==================== Paddle 视觉反馈 ==================== */

.paddle-flash-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  margin-bottom: 8rpx;
  height: 72rpx;
}

.flash-left,
.flash-right {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  opacity: 0;
  transition: all 0.03s;
}

.flash-left.active {
  opacity: 1;
  background-color: rgba(0, 217, 255, 0.25);
  box-shadow: 0 0 24rpx rgba(0, 217, 255, 0.5);
}

.flash-right.active {
  opacity: 1;
  background-color: rgba(233, 69, 96, 0.25);
  box-shadow: 0 0 24rpx rgba(233, 69, 96, 0.5);
}

.flash-symbol {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.flash-left .flash-symbol {
  color: #00d9ff;
}

.flash-right .flash-symbol {
  color: #e94560;
}

/* 振动开关 */
.vibrate-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

/* 侧音开关 */
.audio-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.toggle-label {
  font-size: 20rpx;
  color: #a0a0a0;
}

.toggle-switch {
  width: 72rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: #333;
  position: relative;
  transition: background-color 0.2s;
}

.toggle-switch.on {
  background-color: #e94560;
}

.toggle-knob {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.2s;
}

.toggle-switch.on .toggle-knob {
  transform: translateX(32rpx);
}

/* ==================== 下半区：Paddle 电键 ==================== */

.paddle-area {
  flex: 0 0 auto;
  padding: 20rpx 24rpx 40rpx;
  border-top: 2rpx solid #0f3460;
}

.paddle-hint {
  text-align: left;
  flex-shrink: 0;
}

.paddle-hint-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.paddle-hint text {
  font-size: 24rpx;
  color: #a0a0a0;
  white-space: nowrap;
}

.audio-toggle {
  flex-shrink: 0;
}

.paddle-buttons {
  display: flex;
  gap: 24rpx;
}

.paddle-left,
.paddle-right {
  flex: 1;
  height: 200rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.1s;
}

.paddle-left::after,
.paddle-right::after {
  border: none;
}

.paddle-left {
  background-color: #0f3460;
  border: 4rpx solid #00d9ff;
}

.paddle-right {
  background-color: #0f3460;
  border: 4rpx solid #e94560;
}

.paddle-left.pressed {
  background-color: rgba(0, 217, 255, 0.3);
  transform: scale(0.97);
}

.paddle-right.pressed {
  background-color: rgba(233, 69, 96, 0.3);
  transform: scale(0.97);
}

.paddle-label {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.paddle-left .paddle-label {
  color: #00d9ff;
}

.paddle-right .paddle-label {
  color: #e94560;
}

.paddle-sublabel {
  font-size: 24rpx;
  margin-top: 12rpx;
  color: #a0a0a0;
  font-weight: 500;
  letter-spacing: 4rpx;
}
