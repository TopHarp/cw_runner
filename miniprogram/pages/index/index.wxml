<view class="container" bindtouchstart="onFirstTouch">
  <!-- 上半区：实时时序显示 -->
  <view class="display-area">
    <view class="help-bar">
      <button class="btn-help" bindtap="onHelp">帮助</button>
    </view>
    <view class="display-header">
      <view class="display-actions">
        <button class="btn-send {{timingText.length > 0 ? 'active' : ''}}" bindtap="onSend">保存</button>
        <button class="btn-delete" bindtap="onDelete" bindlongpress="onDeleteLongPress" bindtouchend="onDeleteLongEnd" bindtouchcancel="onDeleteLongEnd">删除</button>
      </view>
    </view>
    <scroll-view class="timing-scroll" scroll-y enhanced show-scrollbar>
      <text class="timing-text {{timingText.length === 0 ? 'placeholder' : ''}}">
        {{timingText || '保存报文所有用户可见：） 强烈推荐振动侧音模式'}}
      </text>
    </scroll-view>
    <view class="wpm-control">
      <text class="wpm-label">电键速度</text>
      <slider class="wpm-slider" 
              min="5" 
              max="40" 
              value="{{wpm}}" 
              show-value
              activeColor="#e94560"
              backgroundColor="#0f3460"
              block-color="#e94560"
              bindchange="onWpmChange"/>
      <text class="wpm-value">{{wpm}} WPM</text>
    </view>
    <!-- 单词间隔调节：新增 -->
    <view class="gap-control">
      <text class="gap-label">报文间隔</text>    <!-- ← 修改：简化文字，与"速度"对应 -->
      <slider class="gap-slider"
              min="2" 
              max="6" 
              step="1"
              value="{{wordGapUnits}}" 
              show-value
              activeColor="#e94560"
              backgroundColor="#0f3460"
              block-color="#e94560"
              bindchange="onWordGapChange"/>
      <text class="gap-value">{{wordGapUnits}} unit</text>   <!-- ← 新增：与 wpm-value 对应 -->
    </view>
  </view>

  <!-- 本地模式提示 -->
  <view class="local-mode-banner" wx:if="{{!cloudEnabled}}">
    <text>本地模式（未开启云端存储）</text>
  </view>

  <!-- 中间：模拟报文列表 -->
  <view class="list-area">
    <view class="list-header">
      <text class="list-title">模拟报文</text>
      <button class="btn-refresh" bindtap="onRefresh">刷新</button>
    </view>
    <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar bindscrolltolower="onLoadMore" lower-threshold="100">
      <block wx:if="{{cwList.length > 0}}">
        <view class="cw-item" wx:for="{{cwList}}" wx:key="_id">
          <text class="cw-index">{{index + 1}}</text>
          <text class="cw-time">{{item.timeStr}}</text>
          <text class="cw-code">{{item.code}}</text>
          <button class="btn-play {{playingId === item._id ? 'playing' : ''}}" 
                  bindtap="onPlay" 
                  data-id="{{item._id}}"
                  data-code="{{item.code}}"
                  data-wpm="{{item.wpm}}">
            {{playingId === item._id ? '▶...' : '▶'}}
          </button>
        </view>
      </block>
      <view class="list-empty" wx:else>
        <text>暂无报文</text>
      </view>
      <view class="load-more" wx:if="{{cwList.length > 0}}">
        <text class="load-more-text {{loadMoreStatus}}">{{loadMoreText}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 下半区：Paddle 电键 -->
  <view class="paddle-area">
    <!-- 视觉提醒：放在左右桨文字上方 -->
    <view class="paddle-flash-area">
      <view class="flash-left {{flashDit ? 'active' : ''}}">
        <text class="flash-symbol">·</text>
      </view>
      <view class="flash-right {{flashDah ? 'active' : ''}}">
        <text class="flash-symbol">−</text>
      </view>
    </view>
    <!-- 左右桨说明 + 振动/侧音开关：同一行 -->
    <view class="paddle-hint-row">
      <view class="paddle-hint">
        <text>左桨: 点(dit) · 右桨: 划(dah)</text>
      </view>
      <view class="vibrate-toggle" bindtap="onVibrateToggle">
        <text class="toggle-label">振动侧音(推荐)</text>
        <view class="toggle-switch {{vibrateEnabled ? 'on' : ''}}">
          <view class="toggle-knob"></view>
        </view>
      </view>
      <view class="audio-toggle" bindtap="onAudioToggle">
        <text class="toggle-label">音频侧音(不推荐)</text>
        <view class="toggle-switch {{audioEnabled ? 'on' : ''}}">
          <view class="toggle-knob"></view>
        </view>
      </view>
    </view>
    <view class="paddle-buttons">
      <button class="paddle-left {{isLeftPressed ? 'pressed' : ''}}"
              bindtouchstart="onLeftPress"
              bindtouchend="onLeftRelease"
              bindtouchcancel="onLeftRelease">
        <view class="paddle-label">·</view>
        <view class="paddle-sublabel">DIT</view>
      </button>
      <button class="paddle-right {{isRightPressed ? 'pressed' : ''}}"
              bindtouchstart="onRightPress"
              bindtouchend="onRightRelease"
              bindtouchcancel="onRightRelease">
        <view class="paddle-label">−</view>
        <view class="paddle-sublabel">DAH</view>
      </button>
    </view>
  </view>
</view>
